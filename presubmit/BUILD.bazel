    name = "golden_test",
    size = "small",
    srcs = ["golden_test.py"],
    data = glob(["testdata/*.test"]),
    deps = [
        ":cli",
        ":source_tree",
    ],
)

py_library(
    name = "backtest_lib",
    srcs = ["backtest.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":cli",
        ":discover",
        ":jobs",
        ":plan",
        ":source_tree",
    ],
)

py_test(
    name = "backtest_test",
    size = "small",
    srcs = ["backtest_test.py"],
    deps = [
        ":backtest_lib",
        ":source_tree",
    ],
)

py_binary(
    name = "backtest_bin",
    srcs = ["backtest_main.py"],
