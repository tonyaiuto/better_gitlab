        ":source_tree",
        ":testing_parser",
        ":testing_py_pb2",
    ],
)

py_test(
    name = "loader_test",
    size = "small",
    srcs = ["loader_test.py"],
    deps = [
        ":loader",
        ":source_tree",
    ],
)

py_library(
    name = "selection",
    srcs = ["selection.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":discover",
        ":loader",
    ],
)

py_test(
    name = "selection_test",
    size = "small",
    srcs = ["selection_test.py"],
    deps = [
        ":discover",
        ":loader",
        ":selection",
        ":source_tree",
    ],
)

py_library(
    name = "plan",
    srcs = ["plan.py"],
    visibility = ["//visibility:public"],
    deps = [":loader"],
)

py_test(
    name = "plan_test",
    size = "small",
    srcs = ["plan_test.py"],
    deps = [
        ":discover",
        ":loader",
        ":plan",
        ":selection",
        ":source_tree",
    ],
)

py_library(
    name = "jobs",
    srcs = ["jobs.py"],
    visibility = ["//visibility:public"],
    deps = [":plan"],
)

py_test(
    name = "jobs_test",
    size = "small",
    srcs = ["jobs_test.py"],
    deps = [
        ":jobs",
        ":plan",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":changed_files",
        ":discover",
        ":jobs",
        ":loader",
        ":plan",
        ":selection",
        ":source_tree",
    ],
)

py_binary(
    name = "presubmit_bin",
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

py_zipapp_binary(
    name = "presubmit",
    binary = ":presubmit_bin",
)

py_test(
    name = "cli_test",
    size = "small",
    srcs = ["cli_test.py"],
    deps = [
        ":changed_files",
        ":cli",
    ],
)

