load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_python//python/zipapp:py_zipapp_binary.bzl", "py_zipapp_binary")

proto_library(
    name = "testing_proto",
    srcs = ["testing.proto"],
    visibility = ["//visibility:public"],
)

py_proto_library(
    name = "testing_py_pb2",
    visibility = ["//visibility:public"],
    deps = [":testing_proto"],
)

py_library(
    name = "testing_parser",
    srcs = ["testing_parser.py"],
    visibility = ["//visibility:public"],
    deps = [":testing_py_pb2"],
)

py_test(
    name = "testing_parser_test",
    size = "small",
    srcs = ["testing_parser_test.py"],
    deps = [":testing_parser"],
)

py_library(
    name = "source_tree",
    srcs = ["source_tree.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "source_tree_test",
    size = "small",
    srcs = ["source_tree_test.py"],
    deps = [":source_tree"],
)

py_library(
    name = "changed_files",
    srcs = ["changed_files.py"],
    visibility = ["//visibility:public"],
    deps = [":source_tree"],
)

py_test(
    name = "changed_files_test",
    size = "small",
    srcs = ["changed_files_test.py"],
    deps = [":changed_files"],
)

py_library(
    name = "discover",
    srcs = ["discover.py"],
    visibility = ["//visibility:public"],
    deps = [":source_tree"],
)

py_test(
    name = "discover_test",
    size = "small",
    srcs = ["discover_test.py"],
    deps = [
        ":discover",
        ":source_tree",
    ],
)

py_library(
    name = "loader",
